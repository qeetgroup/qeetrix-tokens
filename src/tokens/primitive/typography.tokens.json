      "family": {
        "$type": "fontFamily",
        "$description": "Qeet Sans is Cal Sans v2's variable font: one family for headings and interface text, its letter style set per role through the GEOM axis. Fira Code is the code face; Noto Sans covers the Indic scripts Qeet products serve.",

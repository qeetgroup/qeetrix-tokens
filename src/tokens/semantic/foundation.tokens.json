{
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "Font families by role.",
      "heading": {
        "$value": "{primitive.font.family.qeet-sans}"
      },
      "sans": {
        "$value": "{primitive.font.family.qeet-sans}"
      },
      "mono": {
        "$value": "{primitive.font.family.fira-code}"
      },
      "indic": {
        "$value": "{primitive.font.family.noto-indic}"
      }
    },
    "geometry": {
      "$type": "number",
      "$description": "The GEOM axis value per role: display headlines in Qeet Sans's Geo letter style, headings in Base, and body and interface text in A11y, its most legible forms. Each typography role names the one it uses ($extensions[\"in.qeet.qeetrix\"].fontGeometry).",
      "display": {
        "$value": "{primitive.font.geometry.geo}"
      },
      "heading": {
        "$value": "{primitive.font.geometry.base}"
      },
      "body": {
        "$value": 0,
        "$description": "A11y (0), Qeet Sans's most legible letter style. Authored as a value, not an alias: Terrazzo leaves an alias to a 0 unresolved."
      }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Type roles. Every line height lands exactly on the 4px grid: $extensions[\"in.qeet.qeetrix\"].lineHeight is the line height as a length, and lineHeight, the ratio DTCG requires, is that length divided by fontSize at full precision, so fontSize × lineHeight is exactly the length (bun run derive writes it). Letter spacing stays 0 because Qeet Sans spaces each optical size itself, except in label.caps, where small capitals need room to read. $extensions[\"in.qeet.qeetrix\"].fontGeometry is the font.geometry token a role sets on Qeet Sans's GEOM axis: display the display geometry, heading and title the heading geometry, body, label and code the body geometry. A face with no GEOM axis, such as Fira Code, ignores it.",
    "display": {
      "lg": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontSize": "{primitive.font.size.56}",
          "fontWeight": "{primitive.font.weight.semibold}",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.1428571428571428
        },
        "$extensions": {
          "in.qeet.qeetrix": {
            "fontGeometry": "{font.geometry.display}",
            "lineHeight": {
              "value": 4,
              "unit": "rem"
            }
          }
        }
      },
      "md": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontSize": "{primitive.font.size.48}",
          "fontWeight": "{primitive.font.weight.semibold}",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.1666666666666667
        },
        "$extensions": {
          "in.qeet.qeetrix": {
            "fontGeometry": "{font.geometry.display}",
            "lineHeight": {
              "value": 3.5,
              "unit": "rem"
            }
          }
        }
      },
      "sm": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontSize": "{primitive.font.size.40}",
          "fontWeight": "{primitive.font.weight.semibold}",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.2
        },
        "$extensions": {
          "in.qeet.qeetrix": {
            "fontGeometry": "{font.geometry.display}",
            "lineHeight": {
              "value": 3,
              "unit": "rem"
            }
          }
        }
      }
    },

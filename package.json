{
  "name": "@qeetrix/tokens",
  "version": "0.0.2",
  "description": "Qeetrix design tokens — colour, typography, spacing, radius, elevation, motion and density for every Qeet product, as CSS variables, standard DTCG files and typed JavaScript values.",
  "keywords": [
    "design-tokens",
    "design-system",
    "dtcg",
    "css-variables",
    "theming",
    "qeetrix"
  ],
  "license": "MIT",
  "author": "Qeet Group",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeetrix-tokens.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeetrix-tokens/issues"
  },
  "homepage": "https://github.com/qeetgroup/qeetrix-tokens#readme",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./dtcg/*": "./dist/dtcg/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "derive": "node scripts/derive.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./tokens.css",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.2",
    "@terrazzo/parser": "^2.10.0",
    "@types/node": "^22.20.1",
    "culori": "^4.0.2",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
